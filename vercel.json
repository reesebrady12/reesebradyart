{
  "framework": "vite",
  "devCommand": "vite --port $PORT",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/src/(.*)", "dest": "/src/$1" },
    { "src": "/@vite/(.*)", "dest": "/@vite/$1" },
    { "src": "/@react-refresh", "dest": "/@react-refresh" },
    { "src": "/node_modules/(.*)", "dest": "/node_modules/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/art/(.*)", "dest": "/art/$1" },
    { "src": "/(.*\\..*)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
